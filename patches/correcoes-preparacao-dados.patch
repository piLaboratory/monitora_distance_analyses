+        distinct(cnuc, uc, ea, data, ano))
+monitora.amz <-
+    monitora.amz |>
+    mutate(data = if_else(abs(year(data) - ano) > 1,
+                          make_date(ano, month(data), day(data)), data))
+ano_por_data <-
+    monitora.amz |>
+    count(cnuc, data, ano) |>
+    arrange(cnuc, data, desc(n), desc(ano == year(data))) |>
+    group_by(cnuc, data) |>
+    mutate(n_anos = n()) |>
+    slice(1) |>
+    ungroup() |>
+    select(cnuc, data, ano_corrigido = ano, n_anos)
+correcoes_ano$b <-
+    monitora.amz |>
