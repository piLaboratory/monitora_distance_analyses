-    monitora |>
-    filter(taxon_validado!="Canis familiaris",
-           classe=="Mammalia", bioma=="Amazônia",
-           nivel_taxon == "Espécie",
-           distancia < 100) |>
-    mutate(cnuc = as.character(cnuc),
