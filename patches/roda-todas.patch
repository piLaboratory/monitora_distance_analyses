diff --git a/07_combina_tendencias.R b/07_combina_tendencias.R
index a6948a4..0dbc1b8 100644
--- a/07_combina_tendencias.R
+++ b/07_combina_tendencias.R
@@ -14,10 +14,16 @@
 ##   especie <- "Tayassu pecari"
 ##   forcar_modelo <- "g_com"     ## opcional (sensibilidade); se ausente ou NULL,
 ##                                ## usa a escolha gravada pelo 05
+##   crit_min_grupos <- 15; crit_min_anos <- 3   ## opcional (padrao)
 ##   source("07_combina_tendencias.R")
-## Produz: tend_media (UC tipica) e tend_uc (por UC)
+## Produz: tend_media (UC tipica), dens_ind e tend_uc (por UC), gravados em
+## resultados/<Especie>_<modelo>_*.csv
 
 library(ubms); library(brms); library(tidyverse)
+## Criterio para uma UC ter tendencia propria classificada: numero minimo de
+## grupos detectados e de anos com ao menos uma deteccao
+if (!exists("crit_min_grupos")) crit_min_grupos <- 15
+if (!exists("crit_min_anos"))   crit_min_anos   <- 3
 ## Modelo de grupos: o forcado pelo usuario ou o escolhido no 05 (phi)
 if (exists("forcar_modelo") && !is.null(forcar_modelo)) {
     modelo_grupos <- forcar_modelo
@@ -107,6 +113,7 @@ print(as.data.frame(tend_media), digits = 3)
 
 ## Densidade de individuos (ind/ha) no primeiro e no ultimo ano, UC tipica
 dens_ind <- tibble(
+    especie = especie,
     ano = c(ano_min, ano_max),
     media  = c(mean(exp(g0[ig]) * tam_ini), mean(exp(g0[ig] + g1[ig]) * tam_fim)),
     ic_inf = c(quantile(exp(g0[ig]) * tam_ini, 0.025),
@@ -128,7 +135,37 @@ tend_uc <- map_dfr(seq_along(ucs), function(k) {
     mutate(across(-cnuc, as.numeric),
            evidencia = case_when(ic_sup < 0 ~ "declinio",
                                  ic_inf > 0 ~ "aumento",
-                                 TRUE       ~ "inconclusivo")) |>
+                                 TRUE       ~ "inconclusivo"))
+
+## Dados de cada UC: grupos detectados e anos com deteccao (apos truncagem)
+dados_uc <-
+    ua |>
+    mutate(n_grp = rowSums(y_ua), cnuc = as.character(cnuc)) |>
+    summarise(n_grupos = sum(n_grp), anos_amostrados = n(),
+              anos_com_deteccao = sum(n_grp > 0), .by = cnuc)
+
+## UCs que nao atingem o criterio: a tendencia estimada reflete sobretudo a
+## media geral (encolhimento), e nao e classificada
+tend_uc <-
+    tend_uc |>
+    left_join(dados_uc, by = "cnuc") |>
+    mutate(classificavel = n_grupos >= crit_min_grupos &
+                           anos_com_deteccao >= crit_min_anos,
+           evidencia = if_else(classificavel, evidencia, "nao classificavel"),
+           especie = especie, modelo = modelo_grupos) |>
     left_join(distinct(monitora.mam, cnuc, uc), by = "cnuc") |>
-    relocate(uc, .after = cnuc)
+    relocate(especie, modelo, cnuc, uc) |>
+    arrange(desc(classificavel), media)
 print(as.data.frame(tend_uc), digits = 3)
+message(sprintf("07 (%s): %d de %d UCs classificaveis (>= %d grupos em >= %d anos)",
+                especie, sum(tend_uc$classificavel), nrow(tend_uc),
+                crit_min_grupos, crit_min_anos))
+
+################################################################################
+## Grava os resultados
+################################################################################
+dir.create("resultados", showWarnings = FALSE)
+pref_res <- file.path("resultados", paste0(gsub(" ", "_", especie), "_", modelo_grupos))
+write_csv(mutate(tend_media, modelo = modelo_grupos), paste0(pref_res, "_tend_media.csv"))
+write_csv(mutate(dens_ind,  modelo = modelo_grupos), paste0(pref_res, "_dens_ind.csv"))
+write_csv(tend_uc, paste0(pref_res, "_tend_uc.csv"))
diff --git a/08_roda_todas.R b/08_roda_todas.R
new file mode 100644
index 0000000..a4d4d67
--- /dev/null
+++ b/08_roda_todas.R
@@ -0,0 +1,80 @@
+## Roda o fluxo (05 -> 06 -> 07) para todas as especies, uma por vez, cada uma
+## num processo R separado (evita conflitos entre ubms e brms e libera memoria).
+##
+## Retomavel: especies ja concluidas (resultados/<Especie>_concluido.txt) sao
+## puladas; dentro de cada especie, ajustes ja salvos em ajustes_grupos/ sao
+## reaproveitados. Para refazer uma especie, apague o arquivo _concluido.txt
+## (e os .rds em ajustes_grupos/, se quiser reajustar os modelos).
+##
+## Uso (no R, a partir da pasta do projeto):
+##   source("08_roda_todas.R")
+## ou no terminal:
+##   Rscript 08_roda_todas.R
+## Log de cada especie: logs/<Especie>.log
+
+library(tidyverse)
+
+## Criterio de UC classificavel (grupos detectados, anos com deteccao)
+crit_min_grupos <- 15
+crit_min_anos   <- 3
+
+## Especies: as da tabela de ocorrencia conferida
+oc <- read.csv("data/conferencia_ocorrencia_especies_nas_ucs.csv")
+especies <- gsub(".", " ", names(oc)[-(1:2)], fixed = TRUE)
+
+dir.create("logs", showWarnings = FALSE)
+dir.create("resultados", showWarnings = FALSE)
+concluido <- function(sp) file.exists(file.path("resultados",
+                                                paste0(gsub(" ", "_", sp), "_concluido.txt")))
+
+status <- tibble(especie = especies, situacao = NA_character_, minutos = NA_real_)
+for (i in seq_along(especies)) {
+    sp <- especies[i]
+    if (concluido(sp)) { status$situacao[i] <- "ja concluida"; next }
+    message(sprintf("[%d/%d] %s ... (%s)", i, length(especies), sp, format(Sys.time(), "%H:%M")))
+    log <- file.path("logs", paste0(gsub(" ", "_", sp), ".log"))
+    t0 <- Sys.time()
+    saida <- system2(file.path(R.home("bin"), "Rscript"),
+                     c("roda_especie.R", shQuote(sp), crit_min_grupos, crit_min_anos),
+                     stdout = log, stderr = log)
+    status$minutos[i]  <- as.numeric(difftime(Sys.time(), t0, units = "mins"))
+    status$situacao[i] <- if (saida == 0 && concluido(sp)) "ok" else "ERRO (ver log)"
+    message(sprintf("      %s em %.1f min", status$situacao[i], status$minutos[i]))
+}
+print(as.data.frame(status), digits = 3)
+
+################################################################################
+## Junta os resultados de todas as especies
+################################################################################
+escolha <- read_csv("ajustes_grupos/escolha_modelos.csv", show_col_types = FALSE) |>
+    select(especie, modelo_principal)
+junta <- function(sufixo) {
+    arqs <- list.files("resultados", pattern = paste0("_", sufixo, "\\.csv$"), full.names = TRUE)
+    map_dfr(arqs, function(a) mutate(read_csv(a, show_col_types = FALSE),
+                                     across(any_of("cnuc"), as.character))) |>
+        left_join(escolha, by = "especie") |>
+        mutate(principal = modelo == modelo_principal) |>
+        select(-modelo_principal) |>
+        arrange(especie, desc(principal))
+}
+todas_tend_media <- junta("tend_media")
+todas_dens_ind   <- junta("dens_ind")
+todas_tend_uc    <- junta("tend_uc")
+write_csv(todas_tend_media, "resultados/todas_tend_media.csv")
+write_csv(todas_dens_ind,   "resultados/todas_dens_ind.csv")
+write_csv(todas_tend_uc,    "resultados/todas_tend_uc.csv")
+file.copy("ajustes_grupos/comparacao_modelos.csv", "resultados/todas_comparacao_modelos.csv",
+          overwrite = TRUE)
+
+## Resumo: tendencia de individuos (modelo principal) e UCs por categoria
+resumo <-
+    todas_tend_media |>
+    filter(principal, componente == "individuos") |>
+    select(especie, modelo, pct_ano = media, ic_inf, ic_sup, P_declinio) |>
+    left_join(todas_tend_uc |>
+                  filter(principal) |>
+                  count(especie, evidencia) |>
+                  pivot_wider(names_from = evidencia, values_from = n, values_fill = 0),
+              by = "especie")
+print(as.data.frame(resumo), digits = 3)
+write_csv(resumo, "resultados/resumo_tendencias.csv")
diff --git a/roda_especie.R b/roda_especie.R
new file mode 100644
index 0000000..b44eb46
--- /dev/null
+++ b/roda_especie.R
@@ -0,0 +1,33 @@
+## Roda o fluxo completo de UMA especie: 05 (grupos), 06 (tamanho), 07 (combina)
+## O 07 e rodado com o modelo principal e com o outro (sensibilidade).
+## Uso no terminal:  Rscript roda_especie.R "Tayassu pecari"
+## (normalmente chamado pelo 08_roda_todas.R)
+
+args <- commandArgs(trailingOnly = TRUE)
+stopifnot(length(args) >= 1)
+especie <- args[1]
+## Criterio de UC classificavel (pode ser passado como 2o e 3o argumentos)
+crit_min_grupos <- if (length(args) >= 2) as.numeric(args[2]) else 15
+crit_min_anos   <- if (length(args) >= 3) as.numeric(args[3]) else 3
+
+t0 <- Sys.time()
+message("=== ", especie, " | inicio ", format(t0), " ===")
+
+source("05_ajusta_grupos.R")
+source("06_ajusta_tamanho.R")
+
+## Modelo principal (escolhido no 05 pelo phi ajustado)
+forcar_modelo <- NULL
+source("07_combina_tendencias.R")
+principal <- modelo_grupos
+
+## Sensibilidade: o outro modelo de grupos
+forcar_modelo <- setdiff(c("g_sem", "g_com"), principal)
+source("07_combina_tendencias.R")
+
+## Marca a especie como concluida
+dir.create("resultados", showWarnings = FALSE)
+writeLines(c(especie, principal, format(Sys.time())),
+           file.path("resultados", paste0(gsub(" ", "_", especie), "_concluido.txt")))
+message(sprintf("=== %s concluida em %.1f min ===", especie,
+                as.numeric(difftime(Sys.time(), t0, units = "mins"))))
